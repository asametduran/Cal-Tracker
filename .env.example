# Copy this file to .env.local (git-ignored) and restart `npx expo start`.
#
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone who has it.
# Never put a secret here. The Gemini API key lives in Supabase, not in the app (see supabase/README.md).

# --- Supabase (public by design: Row Level Security protects the data, not secrecy) ---
# Find both in the Supabase dashboard under Project Settings > API.
# Leave empty to run device-only: no accounts, data stays on this device, offline mock AI.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- AI backend: proxy | mock | gemini ---
# Unset means: proxy when Supabase is configured, otherwise mock. Release builds always use proxy.
# EXPO_PUBLIC_AI_BACKEND=proxy

# --- Development only: call Gemini directly from the app (EXPO_PUBLIC_AI_BACKEND=gemini) ---
# The key would be readable by anyone with the app, so this code path is excluded from production
# bundles. Prefer the proxy; use a restricted, low-quota key if you use this at all.
# EXPO_PUBLIC_GEMINI_API_KEY=
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
